# Lawmatics access token — obtain once with: npx @oktopeak/lawmatics-mcp auth
# Lawmatics tokens never expire. Store this like a password.
LAWMATICS_ACCESS_TOKEN=

# Read-only mode: set to 1 to disable all write tools (create/update/tag/submit)
# LAWMATICS_READ_ONLY=1

# Enable experimental tools whose API request shape Lawmatics has not fully documented
# LAWMATICS_EXPERIMENTAL_TOOLS=1

# Client-side throttle (default 50 req/min — the conservative documented per-firm limit)
# LAWMATICS_RATE_LIMIT_PER_MIN=50

# Local JSONL audit log of every tool call (default ~/.lawmatics-mcp/audit.log; 0 disables)
# LAWMATICS_AUDIT_LOG=0
# LAWMATICS_AUDIT_LOG_PATH=

# Only needed for the one-time `auth` command:
# LAWMATICS_CLIENT_ID=
# LAWMATICS_CLIENT_SECRET=
# LAWMATICS_REDIRECT_PORT=5678

# API base override (default https://api.lawmatics.com/v1)
# LAWMATICS_API_BASE=
